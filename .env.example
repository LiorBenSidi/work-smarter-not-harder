# Copy to `.env` (NEVER commit `.env` — it's gitignored). docker-compose reads these.
SECRET_KEY=dev-secret-change-me
FLASK_DEBUG=0
TESTING=0
# Set to 1 in production (HTTPS) so the session cookie is marked Secure; 0 for local HTTP / dev.
SESSION_COOKIE_SECURE=0
# MONGO_URI and AI_URL are set on the internal Docker network in docker-compose.yml;
# override here only if you need to point elsewhere.
# --- MongoDB auth (production / Azure) ---
# Local dev: leave BOTH blank -> the db container runs without auth. To ENABLE auth:
#   1. set MONGO_USER + MONGO_PASSWORD (the db creates a root user), AND
#   2. point MONGO_URI at them with authSource=admin (below). If you set the creds but NOT MONGO_URI,
#      every request fails auth at runtime (not at boot). For real prod, make a least-privilege app user.
#   NOTE: mongo creates the root user only on a FRESH volume (first init) — turning auth on for an
#   existing mongo-data volume has NO effect; recreate the volume or add the user via db.createUser.
# MONGO_USER=appuser
# MONGO_PASSWORD=change-me-strong
# MONGO_URI=mongodb://appuser:change-me-strong@db:27017/worksmarter?authSource=admin
# Logging (Week 9 / Lab 9.1): ENABLE_LOGGING=0 turns logging off; LOG_LEVEL is DEBUG/INFO/WARNING/...;
# LOG_FILE is the in-container RotatingFileHandler path (persisted to the web-logs volume).
ENABLE_LOGGING=1
LOG_LEVEL=INFO
LOG_FILE=/app/logs/web.log
# --- Email (2-step login OTP + password reset) ---
# Leave SMTP_HOST blank -> the "log" backend: the OTP / reset link is written to the app log (no creds,
# nothing leaves the box) — fine for dev / demo. To send REAL mail, set a relay (e.g. free Brevo):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key
# Upgrade the SMTP connection to TLS before authenticating. ON by default — setting
# 0 sends the relay password and every one-time code over the network in cleartext.
# SMTP_STARTTLS=1
# MAIL_FROM=Work Smarter <no-reply@yourdomain>
# APP_BASE_URL is the public origin used to build the reset link in emails (set your domain in prod).
APP_BASE_URL=http://localhost:8000
# How long a password-reset link stays valid, in seconds (default 1800 = 30 min).
RESET_TOKEN_MAX_AGE=1800
# 2-step verification: # Dev-only: show auth codes in the HTTP response even when a real SMTP relay is set,
# so the debug panel's Live/Mock switch can read them on screen. NEVER enable on a
# deployment real users can reach — it hands every login code to the caller.
# AUTH_DEBUG_EMAIL=0
OTP_ENABLED=1 emails a login code every login; set 0 to disable 2FA.
# The code expires after OTP_TTL_SECONDS and locks out after OTP_MAX_ATTEMPTS wrong tries.
# "Remember this browser" (opt-in per login) keeps a browser trusted for REMEMBER_COOKIE_MAX_AGE
# seconds (skips OTP); a password change or logout revokes it early.
OTP_ENABLED=1
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
REMEMBER_COOKIE_MAX_AGE=2592000
# Verify the email at signup: 1 emails a code and creates the account only after it's confirmed
# (blocks fake / someone else's address); 0 creates the account immediately. Uses OTP_TTL/ATTEMPTS.
REGISTER_VERIFY_EMAIL=1

# ---------------------------------------------------------------------------
# Tuning knobs. Every one of these has a working default in code, so you can
# leave the whole section commented out — they are listed because otherwise the
# only way to discover them is to read the source.
# ---------------------------------------------------------------------------

# --- Forum/DM media attachments (OWNER: Elad) ---
# Where the bytes live inside the web container (a mounted volume, so uploads
# survive a redeploy). The attachment INDEX lives in Mongo; only blobs go here.
# MEDIA_ROOT=/app/media
# Per-file cap. The upload route raises the body limit to this for POST /media
# only, so an oversized file 413s before it is read. The SPA reads this value to
# reject an over-cap file BEFORE spending a slow link on it (#438).
# MEDIA_MAX_BYTES=10485760            # 10 MB
# Volume-wide cap (#313): once MEDIA_ROOT holds this many bytes, uploads 507.
# A full disk wedges Mongo writes and logging, so this bounds the blast radius
# of an authenticated upload flood that the per-file cap alone would not.
# MEDIA_MAX_TOTAL_BYTES=524288000     # 500 MB
# What may be uploaded at all. The upload route refuses anything outside this list
# with a 400 BEFORE writing, so it is the allowlist, not a hint — SVG is absent on
# purpose (it is script-capable and would be served from our own origin).
# MEDIA_ALLOWED_MIME=image/png,image/jpeg,image/webp,image/gif,video/mp4
# Abandoned-upload reclaim (#557). The composer uploads BEFORE publishing, so a draft someone
# changes their mind about leaves a blob nothing points at — and those count against the cap above
# forever. An UNBOUND blob older than this is reclaimed; an attached one is never touched, at any age.
# MEDIA_UNBOUND_TTL_SECONDS=86400     # 24h
# How often one worker may run that sweep (it rides on uploads — the app has no scheduler).
# MEDIA_SWEEP_INTERVAL_SECONDS=300    # 5 min
# How many blobs one post / comment / DM thread can carry (#331) — bounds the
# serve-time read so listing one target never scans the whole collection.
# MEDIA_MAX_ATTACHMENTS_PER_TARGET=50

# --- Request/response limits ---
# Global JSON body cap. Deliberately small: it guards every JSON route, and the
# media route opts out per-request (see MEDIA_MAX_BYTES).
# MAX_CONTENT_LENGTH=65536            # 64 KB
# Cache lifetime for static files served by Flask.
# SEND_FILE_MAX_AGE_DEFAULT=86400     # 24h
# Master switch for every flask-limiter cap (login, register, forum, upload, DM).
# ON by default; the test suite sets 0 so its rapid calls aren't throttled. Setting
# 0 anywhere reachable from the internet removes the brute-force and flood defences.
# RATELIMIT_ENABLED=1

# --- The timeout ladder (each step MUST stay below the one outside it) ---
#   ai queue 30s  <  web's AI client 33s  <  web gunicorn 45s
# so a slow /predict degrades gracefully (ai_client returns None -> the
# dashboard shows "AI unavailable") instead of gunicorn SIGKILL-ing the worker
# mid-request. Change one and check the others.
# AI_PREDICT_TIMEOUT_SECONDS=30       # how long the ai queue waits for a score
# AI_CLIENT_TIMEOUT_SECONDS=33        # how long web waits on ai

# --- AI job queue (GUIDELINES §2) ---
# Pool size inside each ai container; total parallel scorers = this x replicas.
# AI_QUEUE_WORKERS=4                  # default: min(4, cpu_count)
# AI_QUEUE_MAX_PENDING=64             # queue depth before /predict sheds load (503)
# AI_JOB_TTL_SECONDS=300              # how long a finished job stays readable
# AI_MAX_JOBS=1000                    # hard cap on the in-memory job store
# AI_JOB_HARD_TIMEOUT_SECONDS=120     # a worker producing nothing this long is presumed hung
#                                     # (must exceed AI_PREDICT_TIMEOUT_SECONDS)

# --- Live notifications (SSE) ---
# Each stream pins one gthread thread for its whole life, so both of these exist
# to stop streams starving ordinary requests. The stream cap is clamped to at
# most half of --threads regardless of what you set here.
# EVENTS_MAX_SECONDS=90               # recycle each stream; the browser reconnects
# EVENTS_MAX_STREAMS=3                # concurrent streams per gunicorn worker
