#!/usr/bin/env sh
# Local pre-commit gate -- runs BEFORE the commit is created, so problems are caught on your
# own machine (before any push, before any PR). Mirrors the GitHub-Actions CI.
#   ruff   : lint + the T20 no-print rule (config: pyproject.toml)
#   bandit : security scan of app code (tests + any local venv excluded)
# Tests run on `git push` (see pre-push) so a growing suite doesn't slow every commit.
#
# Safety net, not the authority: CI re-runs everything and `main` is PR-only.
# Emergency bypass:  git commit --no-verify   (CI still gates the PR).
set -e

missing=""
for tool in ruff bandit; do
  command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
if [ -n "$missing" ]; then
  echo "pre-commit FAILED: missing tool(s):$missing"
  echo "  Activate your project venv, then run once:"
  echo "    sh scripts/setup-hooks.sh && pip install -r requirements-dev.txt"
  echo "  Emergency bypass: git commit --no-verify   (CI still gates the PR)"
  exit 1
fi

echo "[pre-commit 1/3] ruff (lint + no-print)..."
ruff check .

echo "[pre-commit 2/3] bandit (security)..."
bandit -r . -q -x ./tests,./.venv,./venv,./env   # exclude tests + any in-repo venv (bandit ignores .gitignore; keeps local == CI)

# Suite counts. Only when this commit touches the suite or the documents that state its size -- an
# unrelated commit should not pay for eight pytest collections.
#
# This hook is a convenience, NOT the gate: hooks are opt-in per clone (scripts/setup-hooks.sh), so
# there is no way to know a teammate has them on. `test_docs_contract` in CI is what actually holds
# the line for everyone. This just saves you a red PR and a second push.
if git diff --cached --name-only | grep -qE '^(tests/|README\.md$|docs/REPORT\.md$|docs/SUBMISSION\.md$)'; then
  # Same interpreter choice as pre-push: `python` first, `python3` only as the fallback. Git Bash on
  # Windows commonly ships `python` and no `python3` at all, so assuming `python3` would silently
  # skip this check for anyone on Windows.
  PY=python
  command -v python >/dev/null 2>&1 || PY=python3

  echo "[pre-commit 3/3] suite counts..."
  if command -v "$PY" >/dev/null 2>&1 && [ -f scripts/sync_counts.py ]; then
    if ! "$PY" scripts/sync_counts.py --check; then
      echo ""
      echo "pre-commit FAILED: the graded docs state a suite size the repo no longer produces."
      echo "  These numbers are GENERATED, not typed. Do not hand-edit them:"
      echo "    $PY scripts/sync_counts.py && git add README.md docs/REPORT.md docs/SUBMISSION.md"
      echo "  Emergency bypass: git commit --no-verify   (CI still gates the PR)"
      exit 1
    fi
  else
    echo "  (skipped: no python interpreter, or scripts/sync_counts.py missing)"
  fi
fi

echo "[pre-commit] OK"
